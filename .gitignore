# ---- Python 缓存 / 虚拟环境 ----
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
.Python
.ipynb_checkpoints/

# ---- 模型权重与二进制产物（体积大、可复现，不入库）----
*.npy
*.npz
*.pt
*.pth
*.ckpt
*.pkl
*.joblib
*.h5
*.onnx
*.bin

# ---- 大体量中间数据（可由 fetch_data.py / build_features_v2.py 重建）----
data/gold_features*.csv
data/gold_raw.csv
!data/*.json

# ---- 实验产物中的预测向量（可复现）----
output/pred_*.npy

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# ---- 日志 ----
*.log
logs/

# ---- 本地环境与密钥（严禁提交）----
.env
.env.*
*.pem
secrets.yaml
credentials.json
token.txt

# ---- WorkBuddy 本地运行数据（不入库）----
# 项目级 skill 需随仓库共享给协作者，故仅排除本地运行数据
.workbuddy/memory/
.workbuddy/cache/
.workbuddy/settings.local.json
.workbuddy/*.log
